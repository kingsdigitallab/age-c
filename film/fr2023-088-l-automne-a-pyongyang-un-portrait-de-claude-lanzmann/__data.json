{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":9},"L'Automne à Pyongyang, un portrait de Claude Lanzmann","Le dernier grand voyage de Claude Lanzmann, le célèbre auteur de \"Shoah\", en Corée du Nord. Il y parle de la vie et de la mort, du communisme, de Simone de Beauvoir et de Jean-Paul Sartre, de \"Shoah\", ...et de lui-même. Un dialogue sans filtre avec le réalisateur. un portrait d'un homme exceptionnel, et d'un pays d'exception.",[4,5,6,7,8],"celebrity","artistic creation","self-employment","personal memory","cultural memory",{"type":10,"id":11,"slug":12,"title":13,"release":15,"filmType":19,"directors":20,"genre":29,"media":32,"synopsis":35,"production":36,"characters":39,"roles":40,"awards":53,"tags":3},"Film","FR2023_088","fr2023-088-l-automne-a-pyongyang-un-portrait-de-claude-lanzmann",{"native":1,"english":14},"",{"type":16,"date":17,"year":18},"Theatrical release","2023-04-12",2023,"Documentary",[21],{"id":22,"slug":23,"name":22,"birthYear":24,"deathYear":25,"gender":26,"nationality":27,"awards":28},"François Margolin","francois-margolin",1955,0,"Male identifying","France",[],[30,31],"Documentary – Participatory mode","Documentary – Observational mode",{"posterUrl":33,"trailerUrl":34},"https://medias.unifrance.org/medias/184/4/263352/format_page/l-automne-a-pyongyang.jpg","https://www.youtube.com/watch?v=fIJ6mDDTIMQ",{"native":2,"english":14},[37],{"country":27,"share":38},"Majority coproducer",[],[41,49],{"person":42,"role":48},{"id":43,"slug":44,"name":43,"birthYear":45,"deathYear":46,"gender":26,"nationality":27,"awards":47},"Claude Lanzmann","claude-lanzmann",1925,2018,[],"Documentary subject",{"person":50,"role":52},{"id":22,"slug":23,"name":22,"birthYear":24,"deathYear":25,"gender":26,"nationality":27,"awards":51},[],"Director of the film",[]],"uses":{"params":["slug"]}}]}
