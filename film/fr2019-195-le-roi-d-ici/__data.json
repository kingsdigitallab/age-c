{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":6},"Le Roi d'ici","Alors qu'il se promenait sous l'orage au pied d'un château en ruine, un simple d'esprit est frappé par la foudre et se croit appelé à régner. Voici dix ans que Jean-Jacques porte couronne, entouré d'une cour qui s'amuse à jouer avec sa folie sympathique. Ayant acquis une solide réputation, notre roi reçoit la visite d’une équipe de tournage : un reportage est fait sur lui. Le Roi d'ici présente son quotidien, sa pensée politique singulièrement illusoire. Mais ne propose-t-il pas de bonnes joies ?",[4,5],"religion","low rank employment",{"type":7,"id":8,"slug":9,"title":10,"release":12,"filmType":16,"directors":17,"genre":25,"media":27,"synopsis":30,"production":31,"characters":34,"roles":35,"awards":52,"tags":3},"Film","FR2019_195","fr2019-195-le-roi-d-ici",{"native":1,"english":11},"",{"type":13,"date":14,"year":15},"Theatrical release","2019-11-13",2019,"Fiction film",[18],{"id":19,"slug":20,"name":19,"birthYear":21,"deathYear":21,"gender":22,"nationality":23,"awards":24},"Avénarius d'Ardronville","avenarius-d-ardronville",0,"Male identifying","France",[],[26],"Comedy",{"posterUrl":28,"trailerUrl":29},"https://medias.unifrance.org/medias/144/63/212880/format_page/le-roi-d-ici.jpg","https://www.youtube.com/watch?v=gSRTG6POJQg",{"native":2,"english":11},[32],{"country":23,"share":33},"Majority coproducer",[],[36,40,46],{"person":37,"role":39},{"id":19,"slug":20,"name":19,"birthYear":21,"deathYear":21,"gender":22,"nationality":23,"awards":38},[],"Director of the film",{"person":41,"role":45},{"id":42,"slug":43,"name":42,"birthYear":21,"deathYear":21,"gender":22,"nationality":23,"awards":44},"François Theurier","francois-theurier",[],"Minor actor/Cameo",{"person":47,"role":45},{"id":48,"slug":49,"name":48,"birthYear":50,"deathYear":21,"gender":22,"nationality":23,"awards":51},"Jean Eckian","jean-eckian",1945,[],[]],"uses":{"params":["slug"]}}]}
