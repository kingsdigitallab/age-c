{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":8},"La Matricola","Nicola 19 enne, orfano di mamma e affetto da allucinazioni si ritrova catapultato nel mondo universitario, senza riuscire a distinguere la realtà dalla finzione. Si imbatterà in coinquilini fuori di testa, preziose amicizie, segreterie malfunzionanti e situazioni irreali. Nel frattempo suo padre Vittorio si ritrova a 50 anni in cassa integrazione e alla ricerca di una nuova compagna... su facebook.",[4,5,6,7],"unemployment","fatherhood","technology","romance",{"type":9,"id":10,"slug":11,"title":12,"release":14,"filmType":18,"directors":19,"genre":27,"media":29,"synopsis":32,"production":33,"characters":36,"roles":37,"awards":49,"tags":3},"Film","IT2014_081","it2014-081-la-matricola",{"native":1,"english":13},"",{"type":15,"date":16,"year":17},"Theatrical release","2014-12-05",2014,"Fiction film",[20],{"id":21,"slug":22,"name":21,"birthYear":23,"deathYear":23,"gender":24,"nationality":25,"awards":26},"Maurizio Valente","maurizio-valente",0,"Male identifying","Italy",[],[28],"Comedy",{"posterUrl":30,"trailerUrl":31},"https://www.imdb.com/it/title/tt3710112/mediaviewer/rm1278578945/?ref_=tt_ov_i","https://www.youtube.com/watch?v=5tcfx7hWxhQ",{"native":2,"english":13},[34],{"country":25,"share":35},"Majority coproducer",[],[38,42],{"person":39,"role":41},{"id":21,"slug":22,"name":21,"birthYear":23,"deathYear":23,"gender":24,"nationality":25,"awards":40},[],"Director of the film",{"person":43,"role":48},{"id":44,"slug":45,"name":44,"birthYear":46,"deathYear":23,"gender":24,"nationality":25,"awards":47},"Umberto Sardella","umberto-sardella",1956,[],"Minor actor/Cameo",[]],"uses":{"params":["slug"]}}]}
