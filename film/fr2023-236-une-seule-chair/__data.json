{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":6},"Une seule chair","Quel est le dessein de Dieu pour la sexualité du couple ? Inspiré de la vision chrétienne de la sexualité développée par Saint Jean-Paul II, enrichie depuis par les papes Benoit XVI puis François, et illustré par de nombreuses expériences pastorales concrètes et des témoignages conjugaux, ce film souhaite faire découvrir l’ampleur de « cet immense trésor confié par Dieu à l’humanité » (Benoît XVI), en vue de réjouir les époux et de guérir et restaurer notre sexualité blessée par le péché.",[4,5],"religion","sex",{"type":7,"id":8,"slug":9,"title":10,"release":12,"filmType":16,"directors":17,"genre":31,"media":33,"synopsis":36,"production":37,"characters":40,"roles":41,"awards":49,"tags":3},"Film","FR2023_236","fr2023-236-une-seule-chair",{"native":1,"english":11},"",{"type":13,"date":14,"year":15},"VOD release","2023-01-01",2023,"Documentary",[18,25],{"id":19,"slug":20,"name":19,"birthYear":21,"deathYear":21,"gender":22,"nationality":23,"awards":24},"Sabrina Gunnell","sabrina-gunnell",0,"Female identifying","France",[],{"id":26,"slug":27,"name":26,"birthYear":28,"deathYear":21,"gender":29,"nationality":23,"awards":30},"Steven Gunnell","steven-gunnell",1974,"Male identifying",[],[32],"Documentary – Participatory mode",{"posterUrl":34,"trailerUrl":35},"https://fr.web.img6.acsta.net/c_310_420/pictures/23/07/27/11/56/2779912.jpg","https://www.youtube.com/watch?v=f7B4wUFWKSY",{"native":2,"english":11},[38],{"country":23,"share":39},"Majority coproducer",[],[42,46],{"person":43,"role":45},{"id":19,"slug":20,"name":19,"birthYear":21,"deathYear":21,"gender":22,"nationality":23,"awards":44},[],"Director of the film",{"person":47,"role":45},{"id":26,"slug":27,"name":26,"birthYear":28,"deathYear":21,"gender":29,"nationality":23,"awards":48},[],[]],"uses":{"params":["slug"]}}]}
