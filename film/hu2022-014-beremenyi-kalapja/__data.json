{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":7},"Bereményi kalapja","Bereményi Géza egyedülálló, kultikus alakja a magyar kultúrának. Először Cseh Tamásnak írt dalszövegeivel lett országosan ismert, aztán novelláival, forgatókönyveivel, színdarabjaival, filmrendezéseivel, az utóbbi években pedig regényíróként is a legnagyobbak közé emelkedett. A Bereményi kalapja portréfilmben Tóth Barnabás kíséri és kérdezi végig Bereményit az életén. Beszélgetőtársát Bereményi, mint fiatal rendező kollégát, és mint egykori gyerekszínészét - aki tíz évesen az Eldorádó c. filmjében épp a gyerek Gézát alakította - avatja be a titkaiba.",[4,5,6],"artistic creation","stages of life","personal memory",{"type":8,"id":9,"slug":10,"title":11,"release":13,"filmType":17,"directors":18,"genre":27,"media":29,"synopsis":32,"production":33,"characters":36,"roles":37,"awards":85,"tags":3},"Film","HU2022_014","hu2022-014-beremenyi-kalapja",{"native":1,"english":12},"",{"type":14,"date":15,"year":16},"Theatrical release","2022-09-22",2022,"Documentary",[19],{"id":20,"slug":21,"name":20,"birthYear":22,"deathYear":23,"gender":24,"nationality":25,"awards":26},"Gábor Zsigmond Papp","gabor-zsigmond-papp",1966,0,"Male identifying","Hungary",[],[28],"Documentary – Expository mode",{"posterUrl":30,"trailerUrl":31},"https://www.imdb.com/title/tt16436646/mediaviewer/rm3897691905/?ref_=tt_ov_i","https://www.youtube.com/watch?v=f1g1ZIt_cWw",{"native":2,"english":12},[34],{"country":25,"share":35},"Majority coproducer",[],[38,46,52,58,64,69,73,79],{"person":39,"role":45},{"id":40,"slug":41,"name":40,"birthYear":42,"deathYear":23,"gender":24,"nationality":43,"awards":44},"András Vetró","andras-vetro",1948,"Romania",[],"Documentary subject",{"person":47,"role":45},{"id":48,"slug":49,"name":48,"birthYear":50,"deathYear":23,"gender":24,"nationality":25,"awards":51},"Bertalan Bagó","bertalan-bago",1962,[],{"person":53,"role":45},{"id":54,"slug":55,"name":54,"birthYear":5