{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":8},"Fischer Iván","Fischer Iván legendás művész, aki évről évre elvarázsolja a világot a Budapesti Fesztiválzenekar élén. Stábunk egy éven át követte három földrészen, tucatnyi ország koncerttermein át. Zajos siker követte útját New Yorktól Hongkongig. A filmben megismerjük Fischer Ivánt karmesteri, rendezői és zeneszerzői énje mellett magánemberként is, és bár a zsenialitásnak nincs receptje, bepillantást nyerhetünk a titokba, amely Fischer Ivánt a zenei élet legnagyobb nemzetközi kritikusa szerint is az év emberévé tette 2014-ben.",[4,5,6,7],"tourism","high rank employment","artistic creation","celebrity",{"type":9,"id":10,"slug":11,"title":12,"release":14,"filmType":18,"directors":19,"genre":28,"media":30,"synopsis":33,"production":34,"characters":37,"roles":38,"awards":49,"tags":3},"Film","HU2015_015","hu2015-015-fischer-ivan",{"native":1,"english":13},"",{"type":15,"date":16,"year":17},"Theatrical release","2015-04-09",2015,"Documentary",[20],{"id":21,"slug":22,"name":21,"birthYear":23,"deathYear":24,"gender":25,"nationality":26,"awards":27},"András Sólyom","andras-solyom",1951,0,"Male identifying","Hungary",[],[29],"Documentary – Expository mode",{"posterUrl":31,"trailerUrl":32},"https://www.imdb.com/title/tt4581606/mediaviewer/rm469785344/?ref_=tt_ov_i","https://www.youtube.com/watch?v=KMJXkJcwfqI&ab_channel=Mafab.hu",{"native":2,"english":13},[35],{"country":26,"share":36},"Majority coproducer",[],[39,43],{"person":40,"role":42},{"id":21,"slug":22,"name":21,"birthYear":23,"deathYear":24,"gender":25,"nationality":26,"awards":41},[],"Director of the film",{"person":44,"role":48},{"id":45,"slug":46,"name":45,"birthYear":23,"deathYear":24,"gender":25,"nationality":26,"awards":47},"Iván Fischer","ivan-fischer",[],"Documentary subject",[]],"uses":{"params":["slug"]}}]}
