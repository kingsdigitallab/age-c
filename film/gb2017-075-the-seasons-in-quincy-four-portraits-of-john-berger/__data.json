{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":4},"The Seasons in Quincy: Four Portraits of John Berger","The Seasons in Quincy' is the result of a five-year project by Tilda Swinton, Colin MacCabe and Christopher Roth to produce a portrait of the intellectual and storyteller John Berger. It was produced by the Derek Jarman Lab, an audio-visual hub for graduate filmmaking based at Birkbeck, University of London, in collaboration with the composer Simon Fisher Turner.",[],{"type":5,"id":6,"slug":7,"title":8,"release":10,"filmType":14,"directors":15,"genre":64,"media":65,"synopsis":68,"production":69,"characters":70,"roles":71,"awards":72,"tags":3},"Film","GB2017_075","gb2017-075-the-seasons-in-quincy-four-portraits-of-john-berger",{"native":1,"english":9},"",{"type":11,"date":12,"year":13},"Theatrical release","2017-06-23",2017,"Documentary",[16,23,29,35],{"id":17,"slug":18,"name":17,"birthYear":19,"deathYear":19,"gender":20,"nationality":21,"awards":22},"Bartek Dziadosz","bartek-dziadosz",0,"Male identifying","Poland",[],{"id":24,"slug":25,"name":24,"birthYear":26,"deathYear":19,"gender":20,"nationality":27,"awards":28},"Colin MacCabe","colin-maccabe",1949,"United Kingdom of Great Britain and Northern Ireland (the)",[],{"id":30,"slug":31,"name":30,"birthYear":32,"deathYear":19,"gender":20,"nationality":33,"awards":34},"Christopher Roth","christopher-roth",1964,"Germany",[],{"id":36,"slug":37,"name":36,"birthYear":38,"deathYear":19,"gender":39,"nationality":40,"awards":41},"Tilda Swinton","tilda-swinton",1960,"Female identifying","Unknown",[42,51,58],{"film":43,"year":47,"award":48,"category":49,"result":50},{"slug":44,"title":45},"gb2023-014-the-eternal-daughter",{"native":46},"The Eternal Daughter",2023,"British Independent Film Awards","Best Leading Performance","Nominated",{"film":52,"year":56,"award":48,"category":57,"result":50},{"slug":53,"title":54},"gb2022-021-the-souvenir-part-ii",{"native":55},"The Souvenir: Part