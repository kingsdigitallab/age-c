{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":6},"À l'air libre","Nichée au fond d'une vallée picarde, une ferme unique en France accueille des détenus en fin de peine, sous le régime du placement extérieur. Une structure d'insertion singulière qui leur propose un logement, un travail, un accompagnement social et une vie communautaire riche et exigeante. Entourés de salariés et bénévoles, ces hommes tentent de se reconstruire et de rebâtir un véritable « projet de vie ».",[4,5],"new start","rural",{"type":7,"id":8,"slug":9,"title":10,"release":12,"filmType":16,"directors":17,"genre":29,"media":32,"synopsis":35,"production":36,"characters":39,"roles":40,"awards":48,"tags":3},"Film","FR2017_201","fr2017-201-a-l-air-libre",{"native":1,"english":11},"",{"type":13,"date":14,"year":15},"Theatrical release","2017-01-01",2017,"Documentary",[18,25],{"id":19,"slug":20,"name":19,"birthYear":21,"deathYear":21,"gender":22,"nationality":23,"awards":24},"Nicolas Ferran","nicolas-ferran",0,"Male identifying","France",[],{"id":26,"slug":27,"name":26,"birthYear":21,"deathYear":21,"gender":22,"nationality":23,"awards":28},"Samuel Gautier","samuel-gautier",[],[30,31],"Documentary – Observational mode","Documentary – Participatory mode",{"posterUrl":33,"trailerUrl":34},"https://images-film-documentaire.fr/film/5CD/8452427AF9D24585AA2F0C72E3E475CD.jpg","https://www.youtube.com/watch?v=Yt79C3FWJVI",{"native":2,"english":11},[37],{"country":23,"share":38},"Majority coproducer",[],[41,45],{"person":42,"role":44},{"id":19,"slug":20,"name":19,"birthYear":21,"deathYear":21,"gender":22,"nationality":23,"awards":43},[],"Director of the film",{"person":46,"role":44},{"id":26,"slug":27,"name":26,"birthYear":21,"deathYear":21,"gender":22,"nationality":23,"awards":47},[],[]],"uses":{"params":["slug"]}}]}
