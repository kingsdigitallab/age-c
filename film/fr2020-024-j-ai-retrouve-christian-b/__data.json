{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":8},"J'ai retrouvé Christian B.","Depuis 50 ans, Alain Fleischer et Christian Boltanski partagent à la fois une amitié indéfectible et un projet documentaire inclassable. La grande rétrospective que le Centre Pompidou consacre à Christian Boltanski jusqu’au printemps 2020 est l’occasion idéale pour Alain Fleischer de dévoiler sa \"pinacothèque\" personnelle, riche d’archives inestimable et plus que rares, inespérées.",[4,5,6,7],"celebrity","artistic creation","stages of life","self-employment",{"type":9,"id":10,"slug":11,"title":12,"release":14,"filmType":18,"directors":19,"genre":28,"media":30,"synopsis":32,"production":33,"characters":36,"roles":37,"awards":49,"tags":3},"Film","FR2020_024","fr2020-024-j-ai-retrouve-christian-b",{"native":1,"english":13},"",{"type":15,"date":16,"year":17},"Theatrical release","2020-02-05",2020,"Documentary",[20],{"id":21,"slug":22,"name":21,"birthYear":23,"deathYear":24,"gender":25,"nationality":26,"awards":27},"Alain Fleischer","alain-fleischer",1944,0,"Male identifying","France",[],[29],"Documentary – Expository mode",{"posterUrl":13,"trailerUrl":31},"https://vimeo.com/517798988",{"native":2,"english":13},[34],{"country":26,"share":35},"Majority coproducer",[],[38,42],{"person":39,"role":41},{"id":21,"slug":22,"name":21,"birthYear":23,"deathYear":24,"gender":25,"nationality":26,"awards":40},[],"Director of the film",{"person":43,"role":48},{"id":44,"slug":45,"name":44,"birthYear":23,"deathYear":46,"gender":25,"nationality":26,"awards":47},"Christian Boltanski","christian-boltanski",2021,[],"Documentary subject",[]],"uses":{"params":["slug"]}}]}
