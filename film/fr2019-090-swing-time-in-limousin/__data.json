{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":7},"Swing Time in Limousin","Une page méconnue de histoire du jazz . Dès 1945, de grands jazzmen américains, victimes de la ségrégation, débarquent en France. Jean-Marie Masse,batteur et fervent défenseur de la musique noire américaine, les invite à Limoges. Ainsi, des légendes du jazz et du blues, comme Lionel Hampton,Bill Coleman, Buck Clayton… se sont produits en Limousin.",[4,5,6],"artistic creation","cultural memory","personal memory",{"type":8,"id":9,"slug":10,"title":11,"release":13,"filmType":17,"directors":18,"genre":32,"media":34,"synopsis":37,"production":38,"characters":41,"roles":42,"awards":58,"tags":3},"Film","FR2019_090","fr2019-090-swing-time-in-limousin",{"native":1,"english":12},"",{"type":14,"date":15,"year":16},"Theatrical release","2019-05-15",2019,"Documentary",[19,27],{"id":20,"slug":21,"name":20,"birthYear":22,"deathYear":23,"gender":24,"nationality":25,"awards":26},"Dilip Varma","dilip-varma",1955,0,"Male identifying","France",[],{"id":28,"slug":29,"name":28,"birthYear":23,"deathYear":23,"gender":30,"nationality":25,"awards":31},"Dominique Varma","dominique-varma","Female identifying",[],[33],"Documentary – Participatory mode",{"posterUrl":35,"trailerUrl":36},"https://medias.unifrance.org/medias/247/33/205303/format_page/swing-time-in-limousin.png","https://www.youtube.com/watch?v=RALPGDAchIk",{"native":2,"english":12},[39],{"country":25,"share":40},"Majority coproducer",[],[43,47,50],{"person":44,"role":46},{"id":20,"slug":21,"name":20,"birthYear":22,"deathYear":23,"gender":24,"nationality":25,"awards":45},[],"Director of the film",{"person":48,"role":46},{"id":28,"slug":29,"name":28,"birthYear":23,"deathYear":23,"gender":30,"nationality":25,"awards":49},[],{"person":51,"role":57},{"id":52,"slug":53,"name":52,"birthYear":54,"deathYear":55,"gender":24,"nationality":25,"awards":56},"Jean-Marie Masse","jean-marie-masse",1921,2015,[],"Documentary subject