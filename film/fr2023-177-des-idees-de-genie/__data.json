{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":8},"Des idées de génie ?","Philippe Ginestet a 67 ans, il est le patron de la chaîne de magasins GIFI et TATI. Mais au sein du club fermé des grands patrons français, il détonne. Self-made man, incarnation française du rêve américain, ses méthodes de management sont atypiques : séminaires de motivation organisés dans son chalet luxueux à Megève, tournois de poker entre employés, voyages à Las Vegas… Une culture d’entreprise poussée à l’extrême. Brice Gravelle pose sa caméra où d’habitude personne ne rentre, à la rencontre de ce grand patron.",[4,5,6,7],"wealth","high rank employment","power","superior-employee relationship",{"type":9,"id":10,"slug":11,"title":12,"release":14,"filmType":18,"directors":19,"genre":28,"media":31,"synopsis":34,"production":35,"characters":38,"roles":39,"awards":44,"tags":3},"Film","FR2023_177","fr2023-177-des-idees-de-genie",{"native":1,"english":13},"",{"type":15,"date":16,"year":17},"Theatrical release","2023-10-04",2023,"Documentary",[20],{"id":21,"slug":22,"name":21,"birthYear":23,"deathYear":24,"gender":25,"nationality":26,"awards":27},"Brice Gravelle","brice-gravelle",1987,0,"Male identifying","France",[],[29,30],"Documentary – Observational mode","Documentary – Participatory mode",{"posterUrl":32,"trailerUrl":33},"https://medias.unifrance.org/medias/29/31/270109/format_page/des-idees-de-genie.jpg","https://www.youtube.com/watch?v=PsdRdTAmAD8",{"native":2,"english":13},[36],{"country":26,"share":37},"Majority coproducer",[],[40],{"person":41,"role":43},{"id":21,"slug":22,"name":21,"birthYear":23,"deathYear":24,"gender":25,"nationality":26,"awards":42},[],"Director of the film",[]],"uses":{"params":["slug"]}}]}
