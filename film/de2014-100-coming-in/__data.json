{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":6},"Coming In","Tom Herzner frisiert die Stars Berlins und hat sich einen Namen als bekanntester Herrenfriseur der Hauptstadt gemacht. Längst haben seine Produkte den Markt für Männer-Shampoos erobert. Da er aber auch die weibliche Klientel bedienen möchte, zu dem der Liebling der Schwulenszene nur wenig Zugang hat, muss er herausfinden, was Frauen wirklich wollen. Bei der Suche nach Antworten lernt der glamouröse Tom, die wilde und selbstbewusste Heidi kennen. Beeindruckt von ihr, stellt er bald fest, dass er dem weiblichen Geschlecht vielleicht doch gar nicht so abgeneigt ist.",[4,5],"urban","lgbtqi",{"type":7,"id":8,"slug":9,"title":10,"release":11,"filmType":15,"directors":16,"genre":25,"media":29,"synopsis":32,"production":34,"characters":37,"roles":38,"awards":57,"tags":3},"Film","DE2014_100","de2014-100-coming-in",{"native":1,"english":1},{"type":12,"date":13,"year":14},"Theatrical release","2014-10-23",2014,"Fiction film",[17],{"id":18,"slug":19,"name":18,"birthYear":20,"deathYear":21,"gender":22,"nationality":23,"awards":24},"Marco Kreuzpaintner","marco-kreuzpaintner",1977,0,"Male identifying","Germany",[],[26,27,28],"Comedy","Drama","Romance",{"posterUrl":30,"trailerUrl":31},"https://www.imdb.com/title/tt3241870/mediaviewer/rm4231589888/?ref_=tt_ov_i","https://www.youtube.com/watch?v=kmHpjqzclDk&ab_channel=WarnerBros.DE",{"native":2,"english":33},"",[35],{"country":23,"share":36},"Majority coproducer",[],[39,47,53],{"person":40,"role":46},{"id":41,"slug":42,"name":41,"birthYear":43,"deathYear":21,"gender":22,"nationality":44,"awards":45},"André Jung","andre-jung",1953,"Luxembourg",[],"Supporting actor",{"person":48,"role":46},{"id":49,"slug":50,"name":49,"birthYear":51,"deathYear":21,"gender":22,"nationality":23,"awards":52},"August Zirner","august-zirner",1956,[],{"person":54,"role":56},{"id":18,"slug":19,"name":18,"birthYear":20,"deathYear":21,"gender":22,"national