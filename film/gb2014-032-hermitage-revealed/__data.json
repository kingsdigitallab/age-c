{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":7},"Hermitage Revealed","Hermitage Revealed A Margy Kinmonth Film 'Hermitage Revealed' vividly brings to life the human stories behind one of the world's greatest art collections in its 250th anniversary year, 2014. The State Hermitage Museum in St. Petersburg is one of the largest and most visited museums in the world, holding over 3 million treasures and world class masterpieces in stunning architectural settings. To celebrate its 250th anniversary in 2014, Margy Kinmonth's film reveals the remarkable stories that have shaped the Hermitage's 250 year journey from Imperial Palace to State Museum.",[4,5,6],"state institutions","urban","artistic creation",{"type":8,"id":9,"slug":10,"title":11,"release":13,"filmType":17,"directors":18,"genre":27,"media":29,"synopsis":32,"production":33,"characters":43,"roles":44,"awards":68,"tags":3},"Film","GB2014_032","gb2014-032-hermitage-revealed",{"native":1,"english":12},"",{"type":14,"date":15,"year":16},"Theatrical release","2014-09-05",2014,"Documentary",[19],{"id":20,"slug":21,"name":20,"birthYear":22,"deathYear":23,"gender":24,"nationality":25,"awards":26},"Margy Kinmonth","margy-kinmonth",1953,0,"Female identifying","United Kingdom of Great Britain and Northern Ireland (the)",[],[28],"Documentary – Performative mode",{"posterUrl":30,"trailerUrl":31},"https://www.imdb.com/title/tt3830664/mediaviewer/rm564991232/?ref_=tt_ov_i","https://www.youtube.com/watch?v=z-Hc7NlqE6U",{"native":2,"english":12},[34,36,39,41],{"country":25,"share":35},"Majority coproducer",{"country":37,"share":38},"United States of America (the)","Minority coproducer",{"country":40,"share":38},"Netherlands (the)",{"country":42,"share":38},"Russian Federation (the)",[],[45,49,53,57,61],{"person":46,"role":48},{"id":20,"slug":21,"name":20,"birthYear":22,"deathYear":23,"gender":24,"nationality":25,"awards":47},[],"Director of the film",{"person":50,"role":52},{"id":20,