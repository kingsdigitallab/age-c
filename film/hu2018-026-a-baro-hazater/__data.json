{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":6},"A báró hazatér","Filmünk egyszerre portré, és költői dokumentumfilm egy mindig új utakat kereső alkotóról, aki hosszú mondataival új távlatokat nyitott az irodalomban. Krasznahorkai László korunk egyik legismertebb magyar írója, akinek világa apokaliptikus, karneválian gazdag, melankolikus, de ironikus is egyben. Pályája és élete folyamatos utazás, melyben olyan kérdésekre keresi a választ, mint: mi a hatalom és az alávetettség, az ismétlés és az időtlenség, a hagyomány és a válság?",[4,5],"artistic creation","stages of life",{"type":7,"id":8,"slug":9,"title":10,"release":12,"filmType":16,"directors":17,"genre":25,"media":28,"synopsis":30,"production":31,"characters":34,"roles":35,"awards":47,"tags":3},"Film","HU2018_026","hu2018-026-a-baro-hazater",{"native":1,"english":11},"",{"type":13,"date":14,"year":15},"Theatrical release","2018-10-20",2018,"Documentary",[18],{"id":19,"slug":20,"name":19,"birthYear":21,"deathYear":21,"gender":22,"nationality":23,"awards":24},"Ádám Breier","adam-breier",0,"Male identifying","Hungary",[],[26,27],"Documentary – Expository mode","Biopic",{"posterUrl":11,"trailerUrl":29},"https://port.hu/galeria/a-baro-hazater/movie-209508?openwith=1196700",{"native":2,"english":11},[32],{"country":23,"share":33},"Majority coproducer",[],[36,43],{"person":37,"role":42},{"id":38,"slug":39,"name":38,"birthYear":40,"deathYear":21,"gender":22,"nationality":23,"awards":41},"László Krasznahorkai","laszlo-krasznahorkai",1954,[],"Documentary subject",{"person":44,"role":46},{"id":19,"slug":20,"name":19,"birthYear":21,"deathYear":21,"gender":22,"nationality":23,"awards":45},[],"Director of the film",[48],{"person":49,"year":50,"award":51,"category":52,"result":53},null,2020,"Magyar Mozgókép Díj (2016-2023)","Best Documentary Film","Nominated"],"uses":{"params":["slug"]}}]}
