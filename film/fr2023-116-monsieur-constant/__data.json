{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":10},"Monsieur Constant","Sur l'île aux moines en Bretagne, Constant Lucas ancien photographe de guerre vit dans le souvenir de celle que l'on surnommait \"l'étoile de Sibérie\". Le vieil homme ne peut oublier cet amour passionnel qui le hante! Son fils Sergio débarque tout à coup sur l'île avec la petite Adéla que le vieil homme ne connait pas...",[4,5,6,7,8,9],"rural","personal memory","fatherhood","loneliness","widowhood","grandfatherhood",{"type":11,"id":12,"slug":13,"title":14,"release":16,"filmType":20,"directors":21,"genre":30,"media":33,"synopsis":36,"production":37,"characters":40,"roles":65,"awards":104,"tags":3},"Film","FR2023_116","fr2023-116-monsieur-constant",{"native":1,"english":15},"",{"type":17,"date":18,"year":19},"Theatrical release","2023-05-17",2023,"Fiction film",[22],{"id":23,"slug":24,"name":23,"birthYear":25,"deathYear":26,"gender":27,"nationality":28,"awards":29},"Alan Simon","alan-simon",1964,0,"Male identifying","France",[],[31,32],"Comedy","Drama",{"posterUrl":34,"trailerUrl":35},"https://medias.unifrance.org/medias/254/2/262910/format_page/monsieur-constant.jpg","https://www.youtube.com/watch?v=LxUafVHjKyY",{"native":2,"english":15},[38],{"country":28,"share":39},"Majority coproducer",[41,56],{"id":42,"film":12,"person":43,"age":49,"gender":27,"sexuality":50,"origin":51,"class":52,"profession":53,"ability":54,"assistedMobility":55},"FR2023_116_01",{"id":44,"slug":45,"name":44,"birthYear":46,"deathYear":26,"gender":27,"nationality":47,"awards":48},"Jean-Claude Drouot","jean-claude-drouot",1938,"Belgium",[],"4: Fourth Age (>75)","Heterosexual","White Western European","Middle class","Retired","Able-bodied","No",{"id":57,"film":12,"person":58,"age":63,"gender":27,"sexuality":50,"origin":51,"class":52,"profession":64,"ability":54,"assistedMobility":55},"FR2023_116_02",{"id":59,"slug":60,"name":59,"birthYear":61,"deathYear":26,"gender":27,"nationality"