{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":6},"A fegyházlelkész (The Prison Chaplain)","Egy fáradhatatlan, saját útját járó, „pántokat feszegető” plébános, fegyházlelkész portréja. Papszenteléskor Butsy Lajos atya egy Ézsaiás idézetet választott jelmondatául: \"Elküldött az Úr, hogy örömhírt vigyek a szegényeknek, szabadulást a foglyoknak és meggyógyítsam a megtört szívűeket.\" És lám, már hét éve a Sopronkőhidai Fegyház és Börtön katolikus fegyházlelkésze. Keze alatt a kemény fiúk kezes báránnyá változnak. Egyetlen titka van, az elődje útmutatása: „szeresd őket!”",[4,5],"mentorship","religion",{"type":7,"id":8,"slug":9,"title":10,"release":13,"filmType":17,"directors":18,"genre":27,"media":29,"synopsis":32,"production":33,"characters":36,"roles":37,"awards":50,"tags":3},"Film","HU2019_023","hu2019-023-a-fegyhazlelkesz",{"native":11,"english":12},"A fegyházlelkész","The Prison Chaplain",{"type":14,"date":15,"year":16},"Theatrical release","2019-01-29",2019,"Documentary",[19],{"id":20,"slug":21,"name":20,"birthYear":22,"deathYear":23,"gender":24,"nationality":25,"awards":26},"Ágota Varga","agota-varga",1954,0,"Female identifying","Hungary",[],[28],"Documentary – Observational mode",{"posterUrl":30,"trailerUrl":31},"https://www.youtube.com/watch?v=WBEe01nGsvk&ab_channel=Varga%C3%81gota","",{"native":2,"english":31},[34],{"country":25,"share":35},"Majority coproducer",[],[38,46],{"person":39,"role":45},{"id":40,"slug":41,"name":40,"birthYear":42,"deathYear":23,"gender":43,"nationality":25,"awards":44},"Lajos Butsy","lajos-butsy",1949,"Male identifying",[],"Documentary subject",{"person":47,"role":49},{"id":20,"slug":21,"name":20,"birthYear":22,"deathYear":23,"gender":24,"nationality":25,"awards":48},[],"Director of the film",[51],{"person":52,"year":53,"award":54,"category":55,"result":56},null,2020,"Magyar Mozgókép Díj (2016-2023)","Best Documentary Film","Nominated"],"uses":{"params":["slug"]}}]}
