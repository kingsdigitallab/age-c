{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":5},"Demokratia","Demokratia prône la démocratie directe et la liberté de la presse libérée des puissances d'argent. En explorant les champs politique et médiatique, fondations de nos « démocraties de marché », avec en toile de fond la lutte contre l’aéroport de Notre Dame des Landes où débat démocratique et information plurielle sont escamotés, les auteurs proposent, à travers un recueil de paroles d’hommes et de femmes libres, de réfléchir ensemble à la fondation d'une véritable démocratie.",[4],"activism",{"type":6,"id":7,"slug":8,"title":9,"release":11,"filmType":15,"directors":16,"genre":29,"media":31,"synopsis":34,"production":35,"characters":38,"roles":39,"awards":47,"tags":3},"Film","FR2015_186","fr2015-186-demokratia",{"native":1,"english":10},"",{"type":12,"date":13,"year":14},"Theatrical release","2015-01-01",2015,"Documentary",[17,24],{"id":18,"slug":19,"name":18,"birthYear":20,"deathYear":20,"gender":21,"nationality":22,"awards":23},"Pablo Girault","pablo-girault",0,"Male identifying","France",[],{"id":25,"slug":26,"name":25,"birthYear":27,"deathYear":20,"gender":21,"nationality":22,"awards":28},"Thierry Kruger","thierry-kruger",1964,[],[30],"Documentary – Participatory mode",{"posterUrl":32,"trailerUrl":33},"https://fr.web.img4.acsta.net/c_310_420/pictures/16/01/12/09/31/424952.jpg","https://www.youtube.com/watch?v=KARx0Mc9Hp0",{"native":2,"english":10},[36],{"country":22,"share":37},"Majority coproducer",[],[40,44],{"person":41,"role":43},{"id":18,"slug":19,"name":18,"birthYear":20,"deathYear":20,"gender":21,"nationality":22,"awards":42},[],"Director of the film",{"person":45,"role":43},{"id":25,"slug":26,"name":25,"birthYear":27,"deathYear":20,"gender":21,"nationality":22,"awards":46},[],[]],"uses":{"params":["slug"]}}]}
