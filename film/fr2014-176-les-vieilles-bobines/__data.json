{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":9},"Les Vieilles Bobines","Étienne Plaisantin, maintenant âgé de 96 ans est une figure emblématique de Moirans-en-Montagne petite ville du Sud Jura. Il filme en amateur depuis 1945 ceux qui l'entourent. Par ailleurs, il a en sa possession des films tournés par René Bariod dans les années 1930. Voilà donc 80 années d'images de vie moirantine et de vie familiale qui se sont accumulées dans les bobines du cinéaste amateur. Ces images, si elles sont touchantes et nostalgiques, nous révèlent aussi les mutations de notre temps.",[4,5,6,7,8],"regional identity","rural","personal memory","legacy","marriage",{"type":10,"id":11,"slug":12,"title":13,"release":15,"filmType":19,"directors":20,"genre":32,"media":34,"synopsis":35,"production":36,"characters":39,"roles":40,"awards":48,"tags":3},"Film","FR2014_176","fr2014-176-les-vieilles-bobines",{"native":1,"english":14},"",{"type":16,"date":17,"year":18},"Theatrical release","2014-01-01",2014,"Documentary",[21,28],{"id":22,"slug":23,"name":22,"birthYear":24,"deathYear":24,"gender":25,"nationality":26,"awards":27},"Jean-Louis Vuillermoz","jean-louis-vuillermoz",0,"Male identifying","France",[],{"id":29,"slug":30,"name":29,"birthYear":24,"deathYear":24,"gender":25,"nationality":26,"awards":31},"Jean-Baptiste Benoit","jean-baptiste-benoit",[],[33],"Documentary – Observational mode",{"posterUrl":14,"trailerUrl":14},{"native":2,"english":14},[37],{"country":26,"share":38},"Majority coproducer",[],[41,45],{"person":42,"role":44},{"id":29,"slug":30,"name":29,"birthYear":24,"deathYear":24,"gender":25,"nationality":26,"awards":43},[],"Director of the film",{"person":46,"role":44},{"id":22,"slug":23,"name":22,"birthYear":24,"deathYear":24,"gender":25,"nationality":26,"awards":47},[],[]],"uses":{"params":["slug"]}}]}
