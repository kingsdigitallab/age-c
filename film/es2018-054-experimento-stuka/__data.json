{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":9},"Experimento Stuka (Experiment Stuka)","En plena Guerra Civil los habitantes de cuatro diminutos pueblos de Castellón ven aparecer tres aviones en el horizonte. Algunos niños salen a saludar, los adultos los miran con inocencia y curiosidad. Pero los aviones maniobran, caen en picado y bombardean casas e iglesias. Matan a 38 vecinos. Nunca entendieron quién fue el responsable. Hasta ahora.",[4,5,6,7,8],"rural","collective trauma","personal trauma","personal memory","war",{"type":10,"id":11,"slug":12,"title":13,"release":16,"filmType":20,"directors":21,"genre":31,"media":35,"synopsis":38,"production":40,"characters":43,"roles":44,"awards":55,"tags":3},"Film","ES2018_054","es2018-054-experimento-stuka",{"native":14,"english":15},"Experimento Stuka","Experiment Stuka",{"type":17,"date":18,"year":19},"Theatrical release","2018-11-08",2018,"Documentary",[22,30],{"id":23,"slug":24,"name":23,"birthYear":25,"deathYear":26,"gender":27,"nationality":28,"awards":29},"José Andreu","jose-andreu",1973,0,"Male identifying","Spain",[],"Rafael Moles",[32,33,34],"Documentary – Participatory mode","Documentary – Performative mode","Documentary – Expository mode",{"posterUrl":36,"trailerUrl":37},"https://www.imdb.com/title/tt9641174/mediaviewer/rm917006336/?ref_=tt_ov_i","https://www.filmaffinity.com/es/evideos.php?movie_id=209977",{"native":2,"english":39},"",[41],{"country":28,"share":42},"Majority coproducer",[],[45,49],{"person":46,"role":48},{"id":23,"slug":24,"name":23,"birthYear":25,"deathYear":26,"gender":27,"nationality":28,"awards":47},[],"Director of the film",{"person":50,"role":48},{"id":51,"slug":52,"name":51,"birthYear":53,"deathYear":26,"gender":27,"nationality":28,"awards":54},"Rafael Molés","rafael-moles",1974,[],[]],"uses":{"params":["slug"]}}]}
