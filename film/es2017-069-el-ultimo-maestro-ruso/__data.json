{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":10},"El último maestro ruso (The Last Russian Master)","Este documental en cuatro actos es testigo de la gestación de la última obra de Ángel Gutiérrez y recorre la trayectoria de un niño de la guerra que, en su juventud, se convirtió en una figura clave de la cultura rusa, importó el método Stanislavski a España y que ha sido maestro de grandes intérpretes, como Eduardo Noriega, Javier Gutiérrez o Luisa Martín.",[4,5,6,7,8,9],"mentorship","education","artistic creation","intergenerational friendship","intergenerational conflict","self-employment",{"type":11,"id":12,"slug":13,"title":14,"release":17,"filmType":21,"directors":22,"genre":31,"media":33,"synopsis":36,"production":38,"characters":41,"roles":42,"awards":68,"tags":3},"Film","ES2017_069","es2017-069-el-ultimo-maestro-ruso",{"native":15,"english":16},"El último maestro ruso","The Last Russian Master",{"type":18,"date":19,"year":20},"Theatrical release","2017-04-28",2017,"Documentary",[23],{"id":24,"slug":25,"name":24,"birthYear":26,"deathYear":27,"gender":28,"nationality":29,"awards":30},"Anaís Berdié","anais-berdie",1983,0,"Female identifying","Spain",[],[32],"Documentary – Participatory mode",{"posterUrl":34,"trailerUrl":35},"https://www.filmaffinity.com/es/film340999.html","https://www.youtube.com/watch?v=nV67D9gNbFA",{"native":2,"english":37},"",[39],{"country":29,"share":40},"Majority coproducer",[],[43,47,55,61],{"person":44,"role":46},{"id":24,"slug":25,"name":24,"birthYear":26,"deathYear":27,"gender":28,"nationality":29,"awards":45},[],"Director of the film",{"person":48,"role":54},{"id":49,"slug":50,"name":49,"birthYear":51,"deathYear":27,"gender":52,"nationality":29,"awards":53},"Carlos Iglesias","carlos-iglesias",1955,"Male identifying",[],"Documentary subject",{"person":56,"role":54},{"id":57,"slug":58,"name":57,"birthYear":59,"deathYear":27,"gender":52,"nationality":29,"awards":60},"Félix Cubero","felix-cu