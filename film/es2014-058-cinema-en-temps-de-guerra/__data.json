{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":11},"Cinema en temps de guerra","Cine en tiempos de guerra revive las vivencias de uno de los últimos directores de fotografía del cine de la República. Joan Mariné fue testimonio de excepción de un momento de la historia del cine catalán que, a pesar de la precariedad económica, la falta de medios y las difíciles circunstancias internacionales, se caracterizó por su alta producción, nunca superada, y su innovación en las formas y contenidos. Mariné es el último superviviente del equipo de Laya Films, la productora de la Generalitat republicana.",[4,5,6,7,8,9,10],"cultural memory","collective trauma","personal memory","legacy","regional identity","national identity","low rank employment",{"type":12,"id":13,"slug":14,"title":15,"release":17,"filmType":21,"directors":22,"genre":30,"media":33,"synopsis":35,"production":36,"characters":39,"roles":40,"awards":52,"tags":3},"Film","ES2014_058","es2014-058-cinema-en-temps-de-guerra",{"native":1,"english":16},"",{"type":18,"date":19,"year":20},"Theatrical release","2014-12-05",2014,"Documentary",[23],{"id":24,"slug":25,"name":24,"birthYear":26,"deathYear":26,"gender":27,"nationality":28,"awards":29},"Bartomeu Vilà","bartomeu-vila",0,"Male identifying","Spain",[],[31,32],"Documentary – Participatory mode","Metacinema",{"posterUrl":16,"trailerUrl":34},"https://www.youtube.com/watch?v=jdvoy_p5f3A",{"native":2,"english":16},[37],{"country":28,"share":38},"Majority coproducer",[],[41,45],{"person":42,"role":44},{"id":24,"slug":25,"name":24,"birthYear":26,"deathYear":26,"gender":27,"nationality":28,"awards":43},[],"Director of the film",{"person":46,"role":51},{"id":47,"slug":48,"name":47,"birthYear":49,"deathYear":26,"gender":27,"nationality":28,"awards":50},"Juan Mariné","juan-marine",1920,[],"Documentary subject",[]],"uses":{"params":["slug"]}}]}
