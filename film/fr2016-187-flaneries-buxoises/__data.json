{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":5},"Flâneries buxoises","Suivons avec curiosité deux adolescents qui se lancent dans la réalisation d’un film sur Buis-les-Baronnies, un village de la Drôme provençale. Chaque étape de leur périple les amènera à découvrir l’histoire locale, son patrimoine millénaire et les espaces naturels qui l'environne, ainsi la célèbre montagne St Julien.",[4],"rural",{"type":6,"id":7,"slug":8,"title":9,"release":11,"filmType":15,"directors":16,"genre":25,"media":27,"synopsis":28,"production":29,"characters":32,"roles":33,"awards":38,"tags":3},"Film","FR2016_187","fr2016-187-flaneries-buxoises",{"native":1,"english":10},"",{"type":12,"date":13,"year":14},"Theatrical release","2016-01-01",2016,"Documentary",[17],{"id":18,"slug":19,"name":18,"birthYear":20,"deathYear":21,"gender":22,"nationality":23,"awards":24},"Lionel Baillemont","lionel-baillemont",1957,0,"Male identifying","France",[],[26],"Documentary – Performative mode",{"posterUrl":10,"trailerUrl":10},{"native":2,"english":10},[30],{"country":23,"share":31},"Majority coproducer",[],[34],{"person":35,"role":37},{"id":18,"slug":19,"name":18,"birthYear":20,"deathYear":21,"gender":22,"nationality":23,"awards":36},[],"Director of the film",[]],"uses":{"params":["slug"]}}]}
