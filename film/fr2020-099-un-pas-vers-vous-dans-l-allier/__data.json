{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":5},"Un pas vers vous dans l'Allier","Des journalistes d'une grande chaîne de télévision dont l'audience est en baisse, sont contraints d abandonner leur sacro-sainte métropole pour réaliser des reportages loin de leur environnement. Ils débarquent dans l'Allier avec tous leurs équipements mais surtout avec un bon nombre de préjugés. Brutalement exposés à ce qu'ils pensent être un monde perdu, leur acclimatation s'annonce des plus surprenantes.",[4],"rural",{"type":6,"id":7,"slug":8,"title":9,"release":11,"filmType":15,"directors":16,"genre":28,"media":30,"synopsis":33,"production":34,"characters":37,"roles":38,"awards":46,"tags":3},"Film","FR2020_099","fr2020-099-un-pas-vers-vous-dans-l-allier",{"native":1,"english":10},"",{"type":12,"date":13,"year":14},"Theatrical release","2020-01-01",2020,"Documentary",[17,24],{"id":18,"slug":19,"name":18,"birthYear":20,"deathYear":20,"gender":21,"nationality":22,"awards":23},"Christopher Tourneur","christopher-tourneur",0,"Male identifying","France",[],{"id":25,"slug":26,"name":25,"birthYear":20,"deathYear":20,"gender":21,"nationality":22,"awards":27},"Stefan Colomb","stefan-colomb",[],[29],"Documentary – Performative mode",{"posterUrl":31,"trailerUrl":32},"https://fr.web.img4.acsta.net/c_310_420/pictures/20/02/04/14/40/5747778.jpg","https://www.allocine.fr/video/player_gen_cmedia=19587523&cfilm=271136.html",{"native":2,"english":10},[35],{"country":22,"share":36},"Majority coproducer",[],[39,43],{"person":40,"role":42},{"id":18,"slug":19,"name":18,"birthYear":20,"deathYear":20,"gender":21,"nationality":22,"awards":41},[],"Director of the film",{"person":44,"role":42},{"id":25,"slug":26,"name":25,"birthYear":20,"deathYear":20,"gender":21,"nationality":22,"awards":45},[],[]],"uses":{"params":["slug"]}}]}
