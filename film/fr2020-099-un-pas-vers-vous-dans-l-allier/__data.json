{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":5},"Un pas vers vous dans l'Allier","Des journalistes d'une grande chaîne de télévision dont l'audience est en baisse, sont contraints d abandonner leur sacro-sainte métropole pour réaliser des reportages loin de leur environnement. Ils débarquent dans l'Allier avec tous leurs équipements mais surtout avec un bon nombre de préjugés. Brutalement exposés à ce qu'ils pensent être un monde perdu, leur acclimatation s'annonce des plus surprenantes.",[4],"rural",{"type":6,"id":7,"slug":8,"title":9,"release":11,"filmType":15,"directors":16,"genre":27,"media":29,"synopsis":32,"production":33,"characters":36,"roles":37,"awards":45,"tags":3},"Film","FR2020_099","fr2020-099-un-pas-vers-vous-dans-l-allier",{"native":1,"english":10},"",{"type":12,"date":13,"year":14},"Theatrical release",null,0,"Documentary",[17,23],{"id":18,"slug":19,"name":18,"birthYear":14,"deathYear":14,"gender":20,"nationality":21,"awards":22},"Christopher Tourneur","christopher-tourneur","Male identifying","France",[],{"id":24,"slug":25,"name":24,"birthYear":14,"deathYear":14,"gender":20,"nationality":21,"awards":26},"Stefan Colomb","stefan-colomb",[],[28],"Documentary – Performative mode",{"posterUrl":30,"trailerUrl":31},"https://fr.web.img4.acsta.net/c_310_420/pictures/20/02/04/14/40/5747778.jpg","https://www.allocine.fr/video/player_gen_cmedia=19587523&cfilm=271136.html",{"native":2,"english":10},[34],{"country":21,"share":35},"Majority coproducer",[],[38,42],{"person":39,"role":41},{"id":18,"slug":19,"name":18,"birthYear":14,"deathYear":14,"gender":20,"nationality":21,"awards":40},[],"Director of the film",{"person":43,"role":41},{"id":24,"slug":25,"name":24,"birthYear":14,"deathYear":14,"gender":20,"nationality":21,"awards":44},[],[]],"uses":{"params":["slug"]}}]}
