{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":5},"Heureux les fêlés","Producteur de cidre, Alex semble s'être résigné à une vie simple d’artisan. Sa rencontre avec Eva lui permet de renouer avec son rêve tenace de faire du cinéma, enfoui à la suite de plusieurs échecs. Avec des compagnons d'infortune, ils relèvent un défi improbable, qui conduit Alex dans une aventure chaotique et lumineuse dont les obstacles réveilleront doutes et démons.",[4],"rural",{"type":6,"id":7,"slug":8,"title":9,"release":11,"filmType":15,"directors":16,"genre":24,"media":27,"synopsis":30,"production":31,"characters":34,"roles":35,"awards":59,"tags":3},"Film","FR2022_160","fr2022-160-heureux-les-feles",{"native":1,"english":10},"",{"type":12,"date":13,"year":14},"Theatrical release","2022-11-09",2022,"Fiction film",[17],{"id":18,"slug":19,"name":18,"birthYear":20,"deathYear":20,"gender":21,"nationality":22,"awards":23},"Robert Coudray","robert-coudray",0,"Male identifying","France",[],[25,26],"Comedy","Drama",{"posterUrl":28,"trailerUrl":29},"https://medias.unifrance.org/medias/223/232/256223/format_page/heureux-les-feles.jpg","https://www.youtube.com/watch?v=wfOGHBhZYmw",{"native":2,"english":10},[32],{"country":22,"share":33},"Majority coproducer",[],[36,43,48,55],{"person":37,"role":42},{"id":38,"slug":39,"name":38,"birthYear":40,"deathYear":20,"gender":21,"nationality":22,"awards":41},"Christophe Hamon","christophe-hamon",1964,[],"Minor actor/Cameo",{"person":44,"role":42},{"id":45,"slug":46,"name":45,"birthYear":20,"deathYear":20,"gender":21,"nationality":22,"awards":47},"Henri-Pierre Thouzeau","henri-pierre-thouzeau",[],{"person":49,"role":42},{"id":50,"slug":51,"name":50,"birthYear":52,"deathYear":53,"gender":21,"nationality":22,"awards":54},"Jean Kergrist","jean-kergrist",1940,2019,[],{"person":56,"role":58},{"id":18,"slug":19,"name":18,"birthYear":20,"deathYear":20,"gender":21,"nationality":22,"awards":57},[],"Director of the film",[]],"