{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":13},"El pintor de Calaveras","El pintor y cineasta Pepe Dámaso (Agaete, Gran Canaria, 1933), convaleciente de una grave enfermedad, decide donar a sus paisanos la obra que ha guardado consigo a lo largo de setenta años. Antes de desprenderse de sus cuadros, Dámaso regresa a los paisajes y argumentos de su infancia, un conjunto de elementos identitarios sobre los que ha labrado una original alegoría plástica de la vida insular",[4,5,6,7,8,9,10,11,12],"physical illness","agony","cultural memory","personal memory","legacy","rural","natural","artistic creation","regional identity",{"type":14,"id":15,"slug":16,"title":17,"release":19,"filmType":23,"directors":24,"genre":33,"media":35,"synopsis":37,"production":38,"characters":41,"roles":42,"awards":54,"tags":3},"Film","ES2018_030","es2018-030-el-pintor-de-calaveras",{"native":1,"english":18},"",{"type":20,"date":21,"year":22},"Theatrical release","2018-04-15",2018,"Documentary",[25],{"id":26,"slug":27,"name":26,"birthYear":28,"deathYear":29,"gender":30,"nationality":31,"awards":32},"Sigfrid Monleón","sigfrid-monleon",1964,0,"Male identifying","Spain",[],[34],"Documentary – Participatory mode",{"posterUrl":36,"trailerUrl":18},"https://www.imdb.com/title/tt9795650/mediaviewer/rm680685312/?ref_=tt_ov_i",{"native":2,"english":18},[39],{"country":31,"share":40},"Majority coproducer",[],[43,50],{"person":44,"role":49},{"id":45,"slug":46,"name":45,"birthYear":47,"deathYear":29,"gender":30,"nationality":31,"awards":48},"Pepe Dámaso","pepe-damaso",1933,[],"Documentary subject",{"person":51,"role":53},{"id":26,"slug":27,"name":26,"birthYear":28,"deathYear":29,"gender":30,"nationality":31,"awards":52},[],"Director of the film",[]],"uses":{"params":["slug"]}}]}
