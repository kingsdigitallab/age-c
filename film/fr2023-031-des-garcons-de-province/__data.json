{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":8},"Des garçons de province (Small-town Boys)","Employé de boîte de nuit, Youcef s’éprend du danseur d’une troupe queer en tournée estivale. Ailleurs, un jeune homme juché sur de hauts talons traverse le village qu’il s’apprête à quitter. Dans un bourg isolé, Jonas a rendez-vous pour des photos érotiques avec un inconnu. Il y a celui qui reste, celui qui part, et celui qui passe. Ce sont des garçons de province.",[4,5,6,7],"artistic creation","self-employment","rural","lgbtqi",{"type":9,"id":10,"slug":11,"title":12,"release":15,"filmType":19,"directors":20,"genre":29,"media":31,"synopsis":34,"production":36,"characters":39,"roles":40,"awards":59,"tags":3},"Film","FR2023_031","fr2023-031-des-garcons-de-province",{"native":13,"english":14},"Des garçons de province","Small-town Boys",{"type":16,"date":17,"year":18},"Theatrical release","2023-02-01",2023,"Fiction film",[21],{"id":22,"slug":23,"name":22,"birthYear":24,"deathYear":25,"gender":26,"nationality":27,"awards":28},"Gaël Lépingle","gael-lepingle",1972,0,"Male identifying","France",[],[30],"Drama",{"posterUrl":32,"trailerUrl":33},"https://medias.unifrance.org/medias/186/247/260026/format_page/des-garcons-de-province.jpg","https://www.youtube.com/watch?v=2Gniaot314w",{"native":2,"english":35},"",[37],{"country":27,"share":38},"Majority coproducer",[],[41,45,51],{"person":42,"role":44},{"id":22,"slug":23,"name":22,"birthYear":24,"deathYear":25,"gender":26,"nationality":27,"awards":43},[],"Director of the film",{"person":46,"role":50},{"id":47,"slug":48,"name":47,"birthYear":25,"deathYear":25,"gender":26,"nationality":27,"awards":49},"Serge Renko","serge-renko",[],"Supporting actor",{"person":52,"role":58},{"id":53,"slug":54,"name":53,"birthYear":55,"deathYear":25,"gender":56,"nationality":27,"awards":57},"Tanya Lopert","tanya-lopert",1942,"Female identifying",[],"Minor actor/Cameo",[]],"uses":{"params":["slug"]}}]}
