{"type":"data","nodes":[null,{"type":"data","data":[{"title":1,"excerpt":2,"tags":3,"film":9},"Matilde Coral, acariciando el aire","Matilde Coral forma parte de la historia de la danza y del flamenco. Heredera del legado de Pastora Imperio, la bailaora ha enseñado al mundo el peculiar estilo del baile de Sevilla: elegante, preciosista y femenino... Trianera de nacimiento y figura universal del flamenco, Matilde Coral ha tenido una vida apasionante dedicada al baile, a su familia y a su gran amor Rafael El Negro.",[4,5,6,7,8],"artistic creation","cultural memory","personal memory","legacy","women empowerment",{"type":10,"id":11,"slug":12,"title":13,"release":15,"filmType":19,"directors":20,"genre":29,"media":32,"synopsis":35,"production":36,"characters":39,"roles":40,"awards":73,"tags":3},"Film","ES2016_075","es2016-075-matilde-coral-acariciando-el-aire",{"native":1,"english":14},"",{"type":16,"date":17,"year":18},"Theatrical release","2016-09-16",2016,"Documentary",[21],{"id":22,"slug":23,"name":22,"birthYear":24,"deathYear":25,"gender":26,"nationality":27,"awards":28},"Paco Ortiz","paco-ortiz",1978,0,"Male identifying","Spain",[],[30,31],"Documentary – Participatory mode","Musical",{"posterUrl":33,"trailerUrl":34},"https://www.imdb.com/title/tt6093638/mediaviewer/rm2682267136/?ref_=tt_ov_i","https://www.filmaffinity.com/es/evideos.php?movie_id=210318",{"native":2,"english":14},[37],{"country":27,"share":38},"Majority coproducer",[],[41,49,56,63,69],{"person":42,"role":48},{"id":43,"slug":44,"name":43,"birthYear":45,"deathYear":46,"gender":26,"nationality":27,"awards":47},"Carlos Saura","carlos-saura",1932,2023,[],"Documentary subject",{"person":50,"role":48},{"id":51,"slug":52,"name":51,"birthYear":53,"deathYear":25,"gender":54,"nationality":27,"awards":55},"Cristina Hoyos","cristina-hoyos",1946,"Female identifying",[],{"person":57,"role":48},{"id":58,"slug":59,"name":58,"birthYear":60,"deathYear":61,"gender":26,"nationality":27,"awards":62},"Manolo Sanlúcar","mano