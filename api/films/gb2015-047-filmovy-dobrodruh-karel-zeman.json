{"type":"Film","id":"GB2015_047","slug":"gb2015-047-filmovy-dobrodruh-karel-zeman","title":{"native":"Filmovy dobrodruh Karel Zeman","english":"Film Adventurer Karel Zeman"},"release":{"type":"First festival screening","date":"2015-03-31","year":2015},"filmType":"Documentary","directors":[{"id":"Tomáš Hodan","slug":"tomas-hodan","name":"Tomáš Hodan","birthYear":1980,"deathYear":0,"gender":"Male identifying","nationality":"Czechia","awards":[]}],"genre":["Metacinema","Documentary – Participatory mode","Documentary – Performative mode"],"media":{"posterUrl":"https://www.imdb.com/title/tt3982912/mediaviewer/rm1914365696/?ref_=tt_ov_i","trailerUrl":"https://www.youtube.com/watch?v=dedPZGZnaJI"},"synopsis":{"native":"A biographical film looking back at the life, work and significance of the genius of world cinema. It reveals the inspiration sources of his work and looks into the kitchen of the film tricks pioneer. As an absolute solitaire in his field, he created his own world based purely on his imagination. He was a complete autodidact and is therefore not easily classifiable into any film wave or direction. This extremely hardworking, resourceful man and a perfectionist, yet always preserving the ability to see the world from a child's perspective is without any doubt one of the most successful and celebrated Czech filmmakers in the world. Thanks to their inner poetry and sincerity, his films do not age","english":""},"production":[{"country":"United Kingdom of Great Britain and Northern Ireland (the)","share":"Majority coproducer"},{"country":"Japan","share":"Minority coproducer"},{"country":"France","share":"Minority coproducer"},{"country":"Czechia","share":"Minority coproducer"}],"characters":[],"roles":[{"person":{"id":"Boris Masník","slug":"boris-masnik","name":"Boris Masník","birthYear":1951,"deathYear":0,"gender":"Male identifying","nationality":"Czechia","awards":[]},"role":"Documentary subject"},{"person":{"id":"Emília Vásáryová","slug":"emilia-vasaryova","n