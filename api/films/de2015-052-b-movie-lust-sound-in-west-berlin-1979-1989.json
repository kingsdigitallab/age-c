sowie Tod und Musik Hand in Hand die Atmosphäre einer ganzen Stadt prägten.","english":"Unreleased footage captures West Berlin's underground scene in the 1980s, from punk to Love Parade, portraying the city's creative energy before the Berlin Wall fell."},"production":[{"country":"Germany","share":"Majority coproducer"}],"characters":[],"roles":[{"person":{"id":"Blixa Bargeld","slug":"blixa-bargeld","name":"Blixa Bargeld","birthYear":1959,"deathYear":0,"gender":"Male identifying","nationality":"Germany","awards":[]},"role":"Documentary subject"},{"person":{"id":"David Hasselhoff","slug":"david-hasselhoff","name":"David Hasselhoff","birthYear":1952,"deathYear":0,"gender":"Male identifying","nationality":"United States of America (the)","awards":[]},"role":"Documentary subject"},{"person":{"id":"Eric Burdon","slug":"eric-burdon","name":"Eric Burdon","birthYear":1941,"deathYear":0,"gender":"Male identifying","nationality":"United Kingdom of Great Britain and Northern Ireland (the)","awards":[]},"role":"Documentary subject"},{"person":{"id":"Gudrun Gut","slug":"gudrun-gut","name":"Gudrun Gut","birthYear":1957,"deathYear":0,"gender":"Female identifying","nationality":"Germany","awards":[]},"role":"Documentary subject"},{"person":{"id":"Heiko Lange","slug":"heiko-lange","name":"Heiko Lange","birthYear":1976,"deathYear":0,"gender":"Male identifying","nationality":"Germany","awards":[]},"role":"Director of the film"},{"person":{"id":"Jörg A. Hoppe","slug":"jorg-a-hoppe","name":"Jörg A. Hoppe","birthYear":1952,"deathYear":0,"gender":"Male identifying","nationality":"Germany","awards":[]},"role":"Director of the film"},{"person":{"id":"Klaus Maeck","slug":"klaus-maeck","name":"Klaus Maeck","birthYear":1954,"deathYear":0,"gender":"Male identifying","nationality":"Germany","awards":[]},"role":"Director of the film"},{"person":{"id":"Monika Döring","slug":"monika-doring","name":"Monika Döring","birthYear":1937,"deathYear":2024,"gender":"Female identifying","nationality":"German