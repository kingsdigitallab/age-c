nce."},"production":[{"country":"France","share":"Majority coproducer"},{"country":"Italy","share":"Minority coproducer"}],"characters":[{"id":"FR2019_021_01","film":"FR2019_021","person":{"id":"Valeria Bruni Tedeschi","slug":"valeria-bruni-tedeschi","name":"Valeria Bruni Tedeschi","birthYear":1964,"deathYear":0,"gender":"Female identifying","nationality":"France","awards":[{"film":{"slug":"fr2021-095-la-fracture","title":{"native":"La Fracture"}},"year":2022,"award":"César du cinéma","category":"Unknown","result":"Nominated"},{"film":{"slug":"fr2020-045-ete-85","title":{"native":"Été 85"}},"year":2021,"award":"César du cinéma","category":"Best Supporting Actress","result":"Nominated"}]},"age":"2: Late Middle Age (55-60)","gender":"Female identifying","sexuality":"Heterosexual","origin":"White Western European","class":"Upper Middle class","profession":"Self-employed","ability":"Able-bodied","assistedMobility":"No"}],"roles":[{"person":{"id":"Bernard Nissille","slug":"bernard-nissille","name":"Bernard Nissille","birthYear":1960,"deathYear":0,"gender":"Male identifying","nationality":"Switzerland","awards":[]},"role":"Minor actor/Cameo"},{"person":{"id":"Bruno Raffaelli","slug":"bruno-raffaelli","name":"Bruno Raffaelli","birthYear":1950,"deathYear":0,"gender":"Male identifying","nationality":"France","awards":[]},"role":"Minor actor/Cameo"},{"person":{"id":"Marisa Borini","slug":"marisa-borini","name":"Marisa Borini","birthYear":1930,"deathYear":0,"gender":"Female identifying","nationality":"Italy","awards":[]},"role":"Minor actor/Cameo"},{"person":{"id":"Noémie Lvovsky","slug":"noemie-lvovsky","name":"Noémie Lvovsky","birthYear":1964,"deathYear":0,"gender":"Female identifying","nationality":"France","awards":[{"film":{"slug":"fr2020-039-la-bonne-epouse","title":{"native":"La Bonne Épouse"}},"year":2021,"award":"César du cinéma","category":"Best Supporting Actress","result":"Nominated"}]},"role":"Supporting actor"},{"person":{"id":"Pierre Arditi","slug":"pierre-ardit